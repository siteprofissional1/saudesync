# ============================================================
# SAÚDE SYNC — ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com suas credenciais.
# ============================================================

# --- BACKEND (Python / FastAPI) ---
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini AI (Chave da API obtida em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Firebase Firestore (Configuração do Backend)
FIREBASE_PROJECT_ID=saudesync
GOOGLE_CLOUD_PROJECT=saudesync
# Caminho para arquivo de Service Account (opcional se usando credenciais locais/emulador)
GOOGLE_APPLICATION_CREDENTIALS=

# Fonte externa para Web Scraping de saúde de Ourinhos e região
LIVE_HEALTH_SOURCE_URL=https://www.ourinhos.sp.gov.br/portal/secretarias/13/secretaria-municipal-de-saude/

# --- FRONTEND (Vite / Firebase Client Web) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=AIzaSyExemploChavePublicaWebFirebase
VITE_FIREBASE_AUTH_DOMAIN=saudesync.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=saudesync
VITE_FIREBASE_STORAGE_BUCKET=saudesync.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=287641911764
VITE_FIREBASE_APP_ID=1:287641911764:web:cb77166673396833b49641
VITE_FIREBASE_MEASUREMENT_ID=G-MR6WTK599S
